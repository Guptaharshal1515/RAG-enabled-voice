# ==========================================================
# Dataset, Processed Chunks & Index Artifacts
# ==========================================================
# Raw and Processed Datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Vector DB & Lexical Indexes
data/index/*.faiss
data/index/*.pkl
data/index/*.pickle
data/index/*.parquet
!data/index/.gitkeep

# Temporary Uploads & Audio Recordings
data/temp_uploads/*
!data/temp_uploads/.gitkeep
*.webm
*.ogg
*.m4a
*.mp3
!data/demo_audio/*.wav

# General Large Binary / Data Extensions
*.parquet
*.feather
*.arrow

